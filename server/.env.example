# =============================================================================
# VEE-ALERT SERVER ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is git-ignored.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────────────────────
PORT=5000

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE — PostgreSQL + Realtime
# Get these from your Supabase project → Settings → API
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# LOCAL OLLAMA AI INFERENCE
# Requires Ollama running locally: https://ollama.ai
# Recommended model: qwen2.5:7b  (run: ollama pull qwen2.5:7b)
# ─────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─────────────────────────────────────────────────────────────────────────────
# GEMINI MULTIMODAL OCR & DOCUMENT EXTRACTION
# Primary high-accuracy extractor for e-papers & document uploads
# Get key: https://aistudio.google.com/
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ─────────────────────────────────────────────────────────────────────────────
# NEWS SOURCES
# ─────────────────────────────────────────────────────────────────────────────

# NewsAPI.org — Global news aggregator (sortBy=publishedAt)
# Get free key: https://newsapi.org/register
NEWSAPI_KEY=

# GNews — AI-curated global news index (100 req/day free tier)
# Get free key: https://gnews.io
GNEWS_API_KEY=

# NewsData.io — Real-time global news archive (200 req/day free tier)
# Get free key: https://newsdata.io/register
NEWSDATA_API_KEY=

# Currents API — Global real-time news
# Get free key: https://currentsapi.services/en/register
CURRENTS_API_KEY=

# The Guardian Content API — Premium editorial wire (currently inactive — leave empty)
# Get key: https://open-platform.theguardian.com/access/
GUARDIAN_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# ALERT CHANNELS
# ─────────────────────────────────────────────────────────────────────────────

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio — WhatsApp + Voice escalation (currently SIMULATED — no live API calls)
# Get credentials: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_TTS_VOICE=Polly.Matthew
TWILIO_VOICE_STATUS_CALLBACK_URL=
EMERGENCY_LEAD_PHONE=

# SendGrid — Email alerts (currently NOT CONFIGURED — email is intentionally skipped)
# Get key: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
ALERT_EMAIL_RECIPIENTS=
ALERT_SENDER_NAME=Vee-Alert

# ─────────────────────────────────────────────────────────────────────────────
# SOCIAL / EXPERIMENTAL
# ─────────────────────────────────────────────────────────────────────────────

# Bluesky Social (optional — for social signal monitoring)
BLUESKY_IDENTIFIER=
BLUESKY_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# GENERAL SETTINGS
# ─────────────────────────────────────────────────────────────────────────────
NOTIFICATION_TIMEOUT_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND / CLIENT (Vite) — also required in client/.env
# ─────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
